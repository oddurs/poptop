#!/bin/sh
# Refuse tool attribution in anything this repository publishes.
#
# Commit messages, file contents and pull request text all end up in public
# history, and none of them is the place for a note about what wrote them. The
# same script backs three layers so they cannot disagree: a commit-msg hook for
# immediate feedback, `./check` before a push, and CI, which cannot be skipped.
#
# Usage:
#   no-attribution FILE...     scan those files
#   no-attribution --stdin     scan standard input
set -eu

# Tool names, the trailer, and the robot. Deliberately *not* a generic
# "generated by": `Cargo.lock`, `ROADMAP.md` and the theme files all say that
# truthfully about themselves, and a check that cries wolf gets switched off.
#
# Split so this file does not match itself, which is why the scans below need
# not special-case it.
pattern="$(printf '%s|%s|cop%s|chat%s|open%s|co-authored-by|ai-(generated|assisted)|\360\237\244\226' \
    'claude' 'anthropic' 'ilot' 'gpt' 'ai')"

scan() {
    what=$1
    shift
    if grep -inE "$pattern" "$@" >/dev/null 2>&1; then
        echo "no-attribution: $what carries tool attribution:" >&2
        grep -inE "$pattern" "$@" >&2
        return 1
    fi
    return 0
}

if [ "${1:-}" = "--stdin" ]; then
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    cat >"$tmp"
    scan "the text" "$tmp"
else
    [ "$#" -gt 0 ] || exit 0
    scan "a file" "$@"
fi

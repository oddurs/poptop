#!/bin/sh
# Everything CI enforces, in the order CI enforces it — and, with `--linux`,
# the same again inside a container so the `/proc` backend is actually built.
#
# The point of this file is the guard in `need`. `src/collect/linux.rs` is
# `cfg`'d out of a macOS build, so on a Mac the container run is the only thing
# that compiles it at all — and `rust:1-slim` ships without clippy, so
# `docker run … cargo clippy` exits with "not installed for the toolchain".
# That is not a lint warning, does not read like one, and counts as zero if you
# are grepping output for warnings. A dead field reached a pull request that
# way, with both platforms apparently green.
#
# So: a missing tool is a failure here, never a skip. Every check that does not
# run is reported as not having run.

set -eu

usage() {
    cat <<'USAGE'
usage: ./check [--linux] [--quick]

  (no flags)  the host toolchain only
  --linux     also run everything inside rust:1-slim, which is the only way a
              Mac compiles the /proc backend
  --quick     fmt, build and test; skip clippy and the live-data smoke tests
USAGE
}

linux=no
quick=no
for arg in "$@"; do
    case "$arg" in
        --linux) linux=yes ;;
        --quick) quick=yes ;;
        -h|--help) usage; exit 0 ;;
        *) echo "check: unknown option $arg" >&2; usage >&2; exit 2 ;;
    esac
done

fail=0

# A tool that is absent is a failed check, not an absent one. This is the whole
# reason the file exists.
need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "check: $1 is not installed — cannot verify, so not claiming to" >&2
        fail=1
        return 1
    fi
    return 0
}

run() {
    what=$1
    shift
    printf '  %-34s' "$what"
    if out=$("$@" 2>&1); then
        echo ok
    else
        echo FAILED
        printf '%s\n' "$out" | sed 's/^/    /'
        fail=1
    fi
}

# Nothing published from here carries a note about what wrote it. Checked on
# every run, because the commit-msg hook only fires for people who wired it up
# and the tracked files are what a reader actually sees.
printf '  %-34s' "no tool attribution"
if git ls-files -z | grep -zv '^\.githooks/' | xargs -0 .githooks/no-attribution >/dev/null 2>&1; then
    echo ok
else
    echo FAILED
    git ls-files -z | grep -zv '^\.githooks/' | xargs -0 .githooks/no-attribution 2>&1 | sed 's/^/    /'
    fail=1
fi

# The hook is opt-in per clone. Say so rather than assume it.
if [ "$(git config core.hooksPath || true)" != ".githooks" ]; then
    echo "  hooks are not wired: git config core.hooksPath .githooks" >&2
fi

echo "host: $(uname -s)"
need cargo || exit 1
run "cargo fmt --check" cargo fmt --check
run "cargo build --all-targets" cargo build --all-targets
run "cargo test" cargo test

if [ "$quick" = no ]; then
    # Not folded into `run`: a missing clippy has to be louder than a lint.
    if cargo clippy --version >/dev/null 2>&1; then
        run "cargo clippy -D warnings" cargo clippy --all-targets -- -D warnings
    else
        echo "  cargo clippy                       NOT INSTALLED"
        echo "    rustup component add clippy" >&2
        fail=1
    fi
    run "--once against live data" cargo run --release -- --once
    # Rust ignores SIGPIPE and turns the write error into a panic, so this is
    # the regression test for `poptop --once | head` taking the tool down.
    run "output survives a closed pipe" sh -c \
        'set -o pipefail 2>/dev/null || true
         cargo run --release -- --once | head -1 >/dev/null
         cargo run --release -- --help | head -1 >/dev/null'
fi

if [ "$linux" = yes ]; then
    echo
    echo "linux: rust:1-slim"
    if need docker; then
        # The components first, and `set -e` inside the container, so a missing
        # one fails the run rather than being read as a clean one. The image
        # ships with neither: adding clippy alone still left `cargo fmt --check`
        # failing as "not installed", which is how this script earned its keep
        # within a minute of being written.
        run "test and clippy in a container" \
            docker run --rm -v "$PWD":/w -w /w -e CARGO_TARGET_DIR=/tmp/t rust:1-slim \
            sh -c 'set -e
                   rustup component add clippy rustfmt
                   cargo fmt --check
                   cargo test
                   cargo clippy --all-targets -- -D warnings'
    fi
fi

echo
if [ "$fail" = 0 ]; then
    echo "all checks ran and passed"
else
    echo "something did not pass, or did not run" >&2
fi
exit "$fail"

#!/bin/sh
# Everything CI enforces, in the order CI enforces it — and, with `--linux`,
# the same again inside a container so the `/proc` backend is actually built.
#
# The point of this file is the guard in `need`. `src/collect/linux.rs` is
# `cfg`'d out of a macOS build, so on a Mac the container run is the only thing
# that compiles it at all — and `rust:1-slim` ships without clippy, so
# `docker run … cargo clippy` exits with "not installed for the toolchain".
# That is not a lint warning, does not read like one, and counts as zero if you
# are grepping output for warnings. A dead field reached a pull request that
# way, with both platforms apparently green.
#
# So: a missing tool is a failure here, never a skip. Every check that does not
# run is reported as not having run.

set -eu

usage() {
    cat <<'USAGE'
usage: ./check [--linux] [--quick] [--perf] [--fuzz[=SECONDS]]

  (no flags)  the host toolchain only
  --linux     also run everything inside rust:1-slim, which is the only way a
              Mac compiles the /proc backend
  --quick     fmt, build and test; skip clippy and the live-data smoke tests
  --perf      also hold every performance budget (src/budget.rs), in a
              release build: sampling, drawing, the store, startup, memory
  --fuzz      also run every fuzz target for SECONDS each (default 60), from
              fuzz/seeds; needs a nightly toolchain and cargo-fuzz. With
              --linux, the /proc targets run in the container too. A crash
              lands in fuzz/artifacts/<target>/ and fails the check.

  For a long run of one target:
    cd fuzz && cargo +nightly fuzz run store -- -max_total_time=3600
USAGE
}

linux=no
quick=no
perf=no
fuzz=0
for arg in "$@"; do
    case "$arg" in
        --linux) linux=yes ;;
        --quick) quick=yes ;;
        --perf) perf=yes ;;
        --fuzz) fuzz=60 ;;
        --fuzz=*) fuzz=${arg#--fuzz=} ;;
        -h|--help) usage; exit 0 ;;
        *) echo "check: unknown option $arg" >&2; usage >&2; exit 2 ;;
    esac
done

fail=0

# A tool that is absent is a failed check, not an absent one. This is the whole
# reason the file exists.
need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "check: $1 is not installed — cannot verify, so not claiming to" >&2
        fail=1
        return 1
    fi
    return 0
}

run() {
    what=$1
    shift
    printf '  %-34s' "$what"
    if out=$("$@" 2>&1); then
        echo ok
    else
        echo FAILED
        printf '%s\n' "$out" | sed 's/^/    /'
        fail=1
    fi
}

# Nothing published from here carries a note about what wrote it. Checked on
# every run, because the commit-msg hook only fires for people who wired it up
# and the tracked files are what a reader actually sees.
#
# Untracked-but-not-ignored files count too. CI scans what is committed, so a
# new file that has not been `git add`ed yet passes here and fails there — one
# push after the moment the fix was free. `--others --exclude-standard` is the
# difference.
printf '  %-34s' "no tool attribution"
attributable() {
    git ls-files -z --cached --others --exclude-standard |
        grep -zv '^\.githooks/'
}
if attributable | xargs -0 .githooks/no-attribution >/dev/null 2>&1; then
    echo ok
else
    echo FAILED
    attributable | xargs -0 .githooks/no-attribution 2>&1 | sed 's/^/    /'
    fail=1
fi

# The hook is opt-in per clone. Say so rather than assume it.
if [ "$(git config core.hooksPath || true)" != ".githooks" ]; then
    echo "  hooks are not wired: git config core.hooksPath .githooks" >&2
fi

echo "host: $(uname -s)"
need cargo || exit 1
run "cargo fmt --check" cargo fmt --check
# `--locked` as well as building: a manifest whose requirement the
# lockfile does not satisfy still builds, by quietly resolving a newer
# dependency — which is how a bump to a crate needing a compiler newer
# than `rust-version` reached master with CI green (#146). The lockfile
# is what a release is built from; if it does not agree with the
# manifest, say so here rather than at whatever version cargo picks.
run "cargo build --locked" cargo build --locked --all-targets
run "cargo build --all-targets" cargo build --all-targets
run "cargo test" cargo test
# The other macOS ABI, under Rosetta. Hand-declared FFI is where the two differ.
if [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ]; then
    if rustup target list --installed 2>/dev/null | grep -q '^x86_64-apple-darwin$' &&
        arch -x86_64 /usr/bin/true 2>/dev/null; then
        run "cargo test, x86_64 under Rosetta" cargo test --target x86_64-apple-darwin
    else
        echo "  x86_64 macOS                      NOT INSTALLED"
        echo "    rustup target add x86_64-apple-darwin; softwareupdate --install-rosetta" >&2
        fail=1
    fi
fi

if [ "$quick" = no ]; then
    # Not folded into `run`: a missing clippy has to be louder than a lint.
    if cargo clippy --version >/dev/null 2>&1; then
        run "cargo clippy -D warnings" cargo clippy --all-targets -- -D warnings
    else
        echo "  cargo clippy                       NOT INSTALLED"
        echo "    rustup component add clippy" >&2
        fail=1
    fi
    run "--once against live data" cargo run --release -- --once
    # Rust ignores SIGPIPE and turns the write error into a panic, so this is
    # the regression test for `poptop --once | head` taking the tool down.
    run "output survives a closed pipe" sh -c \
        'set -o pipefail 2>/dev/null || true
         cargo run --release -- --once | head -1 >/dev/null
         cargo run --release -- --help | head -1 >/dev/null'
fi

# Budgets fail here and are only reported in CI, where a shared runner's
# timing is noise. Release, and one test at a time: they time each other.
if [ "$perf" = yes ]; then
    echo
    echo "perf: every budget, release"
    run "budgets hold" cargo test --release --bin poptop budget:: -- --ignored --test-threads=1
    cargo test --release --bin poptop budget:: -- --ignored --test-threads=1 --nocapture 2>/dev/null |
        sed -n 's/^\(test budget::[a-z_]* \.\.\. \)\{0,1\}  \([a-z]*:.* of .*\)$/    \2/p'
fi

if [ "$linux" = yes ]; then
    echo
    echo "linux: rust:1-slim"
    if need docker; then
        # The components first, and `set -e` inside the container, so a missing
        # one fails the run rather than being read as a clean one. The image
        # ships with neither: adding clippy alone still left `cargo fmt --check`
        # failing as "not installed", which is how this script earned its keep
        # within a minute of being written.
        run "test and clippy in a container" \
            docker run --rm -v "$PWD":/w -w /w -e CARGO_TARGET_DIR=/tmp/t rust:1-slim \
            sh -c 'set -e
                   rustup component add clippy rustfmt
                   cargo fmt --check
                   cargo test
                   cargo clippy --all-targets -- -D warnings'
    fi
fi

# Every fuzz target, for a bounded time, from the committed seeds. The corpus
# a run grows is kept in fuzz/corpus (ignored), so repeated runs go deeper.
# The /proc, NFS and taskstats targets are empty on macOS; they only mean
# anything on Linux, which is what --linux is for.
fuzz_targets() {
    sed -n 's/^name = "\(.*\)"$/\1/p' fuzz/Cargo.toml | grep -v '^poptop-fuzz$'
}
if [ "$fuzz" != 0 ]; then
    echo
    echo "fuzz: ${fuzz}s a target"
    if need cargo-fuzz && cargo +nightly --version >/dev/null 2>&1; then
        for t in $(fuzz_targets); do
            mkdir -p "fuzz/corpus/$t"
            run "fuzz $t" sh -c "cd fuzz && cargo +nightly fuzz run $t corpus/$t seeds/$t \
                -- -max_total_time=$fuzz -timeout=1 -rss_limit_mb=1024 -malloc_limit_mb=1024"
        done
    else
        echo "  nightly toolchain                 NOT INSTALLED"
        echo "    rustup toolchain install nightly" >&2
        fail=1
    fi
    if [ "$linux" = yes ] && need docker; then
        run "fuzz the /proc targets on linux" \
            docker run --rm -v "$PWD":/w -w /w/fuzz -e CARGO_TARGET_DIR=/tmp/t rust:1-slim \
            sh -c "set -e
                   apt-get update -qq && apt-get install -y -qq build-essential >/dev/null
                   rustup toolchain install nightly --profile minimal
                   cargo install cargo-fuzz --locked
                   for t in proc_files nfs taskstats; do
                       mkdir -p /tmp/c/\$t
                       cargo +nightly fuzz run \$t /tmp/c/\$t seeds/\$t -- -max_total_time=$fuzz \
                           -timeout=1 -rss_limit_mb=1024 -malloc_limit_mb=1024
                   done"
    fi
fi

echo
if [ "$fail" = 0 ]; then
    echo "all checks ran and passed"
else
    echo "something did not pass, or did not run" >&2
fi
exit "$fail"
